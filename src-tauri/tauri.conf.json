{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AetherMacro",
  "version": "0.1.0",
  "identifier": "com.aethermacro.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "AetherMacro",
        "url": "index.html",
        "width": 1200,
        "height": 800,
        "minWidth": 420,
        "minHeight": 520,
        "center": true,
        "backgroundColor": "#0f0f0e"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "publisher": "AetherMacro",
    "category": "Utility",
    "shortDescription": "Precision mouse and keyboard automation",
    "longDescription": "AetherMacro builds humanized mouse and keyboard macros by pointing at the running app, with an overlay that works over borderless fullscreen games.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwMDVEQUYxOTExNTRBRjkKUldUNVNoV1I4ZG9GNERrVGJOL0IyZkloSUhIZDJHNHdrcFQvdzhqRm1YdEZ4QU5sOUJBMEVSTnIK",
      "endpoints": [
        "https://github.com/jeelnadaa/mouse-macro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
